{
  "name": "chessfield",
  "version": "2.2.1",
  "description": "A TypeScript+ThreeJS library to render a 3D chessboard",
  "main": "dist/chessfield.umd.js",
  "module": "dist/chessfield.js",
  "types": "dist/chessfield.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/chessfield.d.ts",
      "import": "./dist/chessfield.js",
      "require": "./dist/chessfield.umd.js"
    },
    "./style.css": "./dist/chessfield.css"
  },
  "scripts": {
    "prepareDisable": "$npm_execpath run compile",
    "compile": "tsc --project tsconfig.build.json --sourceMap --declaration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check-format": "oxfmt --check",
    "distEsbuild": "$npm_execpath run compile && $npm_execpath run bundle",
    "dist": "vite build --config vite.config.ts --mode production",
    "dist:dev": "vite build --config vite.config.ts --mode development",
    "bundleEsbuild": "esbuild src/chessfield.ts --bundle --format=esm --outfile=dist/chessfield.min.js --minify --loader:.jpg=file --loader:.glb=file --loader:.json=file --public-path=/assets/ --sourcemap",
    "dev": "vite --config vite.config.ts",
    "devEsbuild": "esbuild src/chessfield.ts --bundle --format=esm --outfile=dist/chessfield.js --loader:.jpg=file --loader:.glb=file --loader:.json=file --public-path=/dist/ --servedir=. --serve=8000 --watch --sourcemap",
    "docs": "mkdocs serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-golden": "^0.1.2",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@lichess-org/chessground": ">=10.4.0",
    "three": "0.186.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": false
    },
    "@lichess-org/chessground": {
      "optional": false
    }
  },
  "keywords": [
    "chess",
    "chessboard",
    "3d",
    "typescript"
  ],
  "author": "Gilles Hoarau (https://github.com/unicolored)",
  "license": "MIT",
  "files": [
    "dist/*"
  ],
  "repository": {
    "url": "git+https://github.com/unicolored/chessfield.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@chess-fu/fen-parser": "^1.1.4"
  }
}
