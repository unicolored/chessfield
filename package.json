{
  "name": "chessfield",
  "description": "A TypeScript+ThreeJS library to render a 3D chessboard",
  "main": "dist/chessfield.umd.js",
  "module": "dist/chessfield.js",
  "types": "dist/chessfield.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/chessfield.js",
      "require": "./dist/chessfield.umd.js"
    },
    "./style.css": "./dist/chessfield.css"
  },
  "scripts": {
    "prepare": "$npm_execpath run compile",
    "compile": "tsc --sourceMap --declaration",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "check-format": "oxfmt --check",
    "dist": "$npm_execpath run compile && $npm_execpath run bundle",
    "bundle": "esbuild src/chessfield.ts --bundle --format=esm --outfile=dist/chessfield.min.js --minify --loader:.jpg=file --loader:.glb=file --loader:.json=file --public-path=/assets/ --sourcemap",
    "dev": "esbuild src/chessfield.ts --bundle --format=esm --outfile=dist/chessfield.js --loader:.jpg=file --loader:.glb=file --loader:.json=file --public-path=/dist/ --servedir=. --serve=8000 --watch --sourcemap",
    "docs": "mkdocs serve",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@chess-fu/fen-parser": "^1.1.4",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@lichess-org/chessground": "^10.2.0",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "esbuild": "^0.28.1",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.79.0",
    "oxlint-plugin-golden": "^0.1.2",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.5.3",
    "rxjs": "^7.8.2",
    "terser": "^5.39.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^6.2.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "chess",
    "chessboard",
    "3d",
    "typescript"
  ],
  "author": "Gilles Hoarau (https://github.com/unicolored)",
  "license": "MIT",
  "files": [
    "dist/*"
  ],
  "repository": {
    "url": "git+https://github.com/unicolored/chessfield"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
